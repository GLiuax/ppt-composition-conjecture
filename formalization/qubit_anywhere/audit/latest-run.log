fun {a b} k Q => ∃ r z, Q = ∑ t, PPTQubit.pureProjector (z t) ∧ ∀ (t : Fin r), PPTQubit.SchmidtRankAtMost k (z t)
def PPTQubit.SchmidtTrimming : {p q : ℕ} → PPTQubit.MatrixMap p q → Prop :=
fun {p q} T =>
