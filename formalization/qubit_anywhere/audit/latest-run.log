fun p q => Matrix (Fin p) (Fin p) ℂ →ₗ[ℂ] Matrix (Fin q) (Fin q) ℂ
def PPTQubit.IsPPT.{u_1, u_2} : {p : Type u_1} →
  {m : Type u_2} → [Fintype p] → [Fintype m] → Matrix (p × m) (p × m) ℂ → Prop :=
fun {p} {m} [Fintype p] [Fintype m] X => X.PosSemidef ∧ (PPTQubit.partialTransposeFirst X).PosSemidef
def PPTQubit.IsPPTMap : {p q : ℕ} → PPTQubit.MatrixMap p q → Prop :=
fun {p q} T => PPTQubit.IsPPT (PPTQubit.choi T)
def PPTQubit.IsSeparable.{u_1, u_2} : {p : Type u_1} → {m : Type u_2} → Matrix (p × m) (p × m) ℂ → Prop :=
fun {p} {m} Q => ∃ r v w, ∀ (i : p) (a : m) (j : p) (b : m), Q (i, a) (j, b) = ∑ s, v s i * w s a * star (v s j * w s b)
def PPTQubit.IsEntanglementBreaking : {p q : ℕ} → PPTQubit.MatrixMap p q → Prop :=
fun {p q} T =>
  ∀ (n : ℕ) (X : Matrix (Fin n × Fin p) (Fin n × Fin p) ℂ),
    X.PosSemidef → PPTQubit.IsSeparable ((PPTQubit.applySecond T) X)
def PPTQubit.SchmidtRankAtMost : {a b : ℕ} → ℕ → (Fin a × Fin b → ℂ) → Prop :=
fun {a b} k z => ∃ v w, ∀ (i : Fin a) (j : Fin b), z (i, j) = ∑ t, v t i * w t j
